url: "https://www.wavespestcontrol.com/tools/lawn-watering-calculator/"
license: MIT
version: "1.2.0"
date-released: "2026-11-02"
keywords:
  - irrigation
  - lawn care
  - turfgrass
  - Florida
  - evapotranspiration
  - watering restrictions
